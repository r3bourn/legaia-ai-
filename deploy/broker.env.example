# Copy to /etc/legaia-ai/broker.env and chmod 600.
# Do NOT commit the real file.

# claude | codex | ollama
LEGAIA_AI_PROVIDER=claude

# Loopback is the safe default. Put a reverse proxy on the same Linux host if
# the browser needs remote access; do not expose Claude/Codex directly.
LEGAIA_AI_BIND=127.0.0.1:4317

# Local structured checkpoint guide. Keep user-supplied walkthrough text and
# generated guide files outside Git; /srv/legaia-private is the recommended
# location in docs/ai-player.md.
# LEGAIA_GUIDE_PATH=/srv/legaia-private/guide.yaml

# Only required if you intentionally bind the broker to a non-loopback IP.
# LEGAIA_AI_BEARER_TOKEN=replace-with-a-long-random-secret

# Only needed for a browser that calls the broker cross-origin. Prefer a
# same-origin reverse proxy instead.
# LEGAIA_AI_CORS_ORIGIN=https://legaia.example.com

# Optional command overrides if the CLIs are not on the service user's PATH.
# LEGAIA_CLAUDE_COMMAND=/usr/local/bin/claude
# LEGAIA_CODEX_COMMAND=/usr/local/bin/codex
# LEGAIA_OLLAMA_COMMAND=/usr/local/bin/ollama

# Ollama fallback model.
LEGAIA_OLLAMA_MODEL=qwen3:8b
